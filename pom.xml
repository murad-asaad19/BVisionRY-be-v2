<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.7</version>
        <relativePath/>
    </parent>

    <groupId>com.bvisionry</groupId>
    <artifactId>bvisionry-api</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>BVisionRY API</name>
    <description>AI-Powered Self-Assessment Platform</description>

    <properties>
        <java.version>21</java.version>
        <langchain4j.version>1.11.8</langchain4j.version>
        <resilience4j.version>2.2.0</resilience4j.version>
        <!-- 7.x is the line that targets Spring Boot 4 / Spring 7 and requires JVM 17+. -->
        <shedlock.version>7.7.0</shedlock.version>
        <!-- OpenSAML is declared `optional` by spring-security-saml2-service-provider,
             so the two artifacts we compile against must be requested explicitly. Pinned
             exactly (never a range) because they resolve from the Shibboleth repository
             declared below, where a floating version is a supply-chain surface. NOTE this
             pins only the two coordinates we declare; their transitives (opensaml-core-*,
             opensaml-xmlsec-*, net.shibboleth:shib-*) are pinned by OpenSAML's own poms,
             not here — `./mvnw dependency:list` is the way to see the resolved set. -->
        <opensaml.version>5.1.6</opensaml.version>

        <!-- SECURITY BUMPS over what spring-boot-starter-parent 4.0.7 manages.
             Each one is an advisory the OSV gate below (see osv-scanner.toml)
             flagged as FIXABLE, so it is fixed here rather than baselined —
             the baseline is for debt that has no upgrade, and adding an id to
             it that a property override would close is accepted risk nobody
             needed to accept. Drop each line once the parent's own managed
             version reaches it (`./mvnw help:evaluate -Dexpression=<prop>`). -->
        <!-- GHSA-hjcp-jmpx-g3qm (5.3) — parent manages 5.5.2. -->
        <httpclient5.version>5.6.3</httpclient5.version>
        <!-- GHSA-hf6x-8p5f-cgmf + GHSA-v3jc-474w-2wm6 (7.5) — parent manages
             5.3.6, and this property versions httpcore5 and httpcore5-h2. -->
        <httpcore5.version>5.4.3</httpcore5.version>
        <!-- GHSA-qv9r-c865-cp47 (6.3) — parent manages 2.25.4. -->
        <log4j2.version>2.25.5</log4j2.version>
    </properties>

    <!--
      Maven Central carried OpenSAML up to 4.0.1 and stops there; the 5.x line — the only
      one Spring Security 7 supports — is published solely by the Shibboleth Foundation,
      so spring-security-saml2-service-provider cannot resolve without this repository.

      RELEASES ONLY: snapshots are disabled, so a build can never silently pick up an
      unreviewed artifact.

      CONTAINMENT. A POM-declared repository is searched BEFORE the inherited Central
      (`mvn help:effective-pom` shows the order as shibboleth-releases, central), so
      declaring it alone would send every artifact in the build to Shibboleth first on a
      cold cache, and take its checksums from there. That is closed in `.mvn/maven.config`
      by Resolver's groupId remote-repository filter: `.mvn/rrf/groupId-shibboleth-releases.txt`
      allows exactly `org.opensaml` and `net.shibboleth` from this repository, and nothing
      else is ever requested from it. Central has no filter file, and `noInputOutcome`
      defaults to true, so Central stays unfiltered and still serves the whole build.
      The allowlist was generated, not guessed, with
      `-Daether.remoteRepositoryFilter.groupId.record=true`.

      TRUST. Containment says WHAT may come from here; it does not say the bytes are the
      bytes we reviewed. `.mvn/checksums/checksums-shibboleth-releases.sha1` pins every
      artifact this repository serves, and Resolver refuses any mismatch — including on a
      warm-cache offline build. Bumping ${opensaml.version} therefore also means
      re-recording that file; `.mvn/maven.config` carries the command.
    -->
    <repositories>
        <repository>
            <id>shibboleth-releases</id>
            <name>Shibboleth Releases</name>
            <url>https://build.shibboleth.net/maven/releases/</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>

    <dependencies>
        <!-- Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <!-- JSON -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jackson</artifactId>
        </dependency>

        <!-- Data -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <!-- Spring Boot 4 split Flyway auto-config into its own module. Without
             this, Spring Boot does not register FlywayJpaDependencyConfiguration,
             so entityManagerFactory does not depend on Flyway and Hibernate's
             schema validation runs before migrations apply. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>

        <!-- Cache -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- Security -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- Enterprise SSO. Both are Spring Security's own modules (versions managed by
             the Boot parent), deliberately NOT the `spring-boot-starter-oauth2-client`
             starter: registrations are per-tenant rows in the DB, so the starter's
             properties-driven auto-config has nothing to build and would only add a
             second, competing ClientRegistrationRepository source.

             saml2-service-provider brings OpenSaml5AuthenticationProvider, which does the
             signature / audience / InResponseTo / recipient validation. oauth2-client
             brings OidcAuthorizationCodeAuthenticationProvider + (transitively)
             spring-security-oauth2-jose, which verifies the id_token's JWS against the
             issuer's JWKS. Neither validation is ever hand-rolled here. -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-saml2-service-provider</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-oauth2-client</artifactId>
        </dependency>
        <!-- oauth2-client declares this `optional`, but OidcAuthorizationCodeAuthenticationProvider
             needs it: it is the JWS/JWKS verification of the id_token. Omitting it would leave
             the OIDC half unable to verify a signature at all. -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-oauth2-jose</artifactId>
        </dependency>
        <dependency>
            <groupId>org.opensaml</groupId>
            <artifactId>opensaml-saml-api</artifactId>
            <version>${opensaml.version}</version>
        </dependency>
        <dependency>
            <groupId>org.opensaml</groupId>
            <artifactId>opensaml-saml-impl</artifactId>
            <version>${opensaml.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- JWT -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.12.6</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Scheduling: ShedLock guards the @Scheduled reaper/expiry jobs so that
             when Railway scales past one replica each job runs on at most one instance
             per tick (no duplicate trial-expiry / reap DB writes). JDBC (Postgres)
             provider on purpose, NOT Redis: the DB is a hard dependency while Redis is
             deliberately allowed to degrade (excluded from health checks), so the lock
             must not hinge on Redis being up. Replaces the previously declared but
             entirely unused Quartz starter (all scheduling is plain @EnableScheduling). -->
        <dependency>
            <groupId>net.javacrumbs.shedlock</groupId>
            <artifactId>shedlock-spring</artifactId>
            <version>${shedlock.version}</version>
        </dependency>
        <dependency>
            <groupId>net.javacrumbs.shedlock</groupId>
            <artifactId>shedlock-provider-jdbc-template</artifactId>
            <version>${shedlock.version}</version>
        </dependency>

        <!-- Mail -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!-- Templating (email templates + PDF) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>

        <!-- Mustache for user-editable email templates (logic-less, no code execution) -->
        <dependency>
            <groupId>com.samskivert</groupId>
            <artifactId>jmustache</artifactId>
            <version>1.16</version>
        </dependency>

        <!-- HTML sanitisation for admin-typed email template fields (allowlist policy
             prevents HTML injection in RICH_TEXT fields; PLAIN_TEXT is escaped). -->
        <dependency>
            <groupId>com.googlecode.owasp-java-html-sanitizer</groupId>
            <artifactId>owasp-java-html-sanitizer</artifactId>
            <version>20260313.1</version>
        </dependency>

        <!-- PDF generation (HTML to PDF via Flying Saucer + OpenPDF) -->
        <dependency>
            <groupId>org.xhtmlrenderer</groupId>
            <artifactId>flying-saucer-pdf-openpdf</artifactId>
            <version>9.4.0</version>
        </dependency>

        <!-- Excel generation (XSSF workbooks) -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.4.0</version>
            <exclusions>
                <exclusion>
                    <groupId>org.apache.logging.log4j</groupId>
                    <artifactId>log4j-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- MinIO (S3-compatible) object storage for lesson media uploads (#39) -->
        <dependency>
            <groupId>io.minio</groupId>
            <artifactId>minio</artifactId>
            <version>8.6.0</version>
        </dependency>
        <!-- minio 8.6.0 moved to okhttp 5.x, which Maven (unlike Gradle) resolves to
             the "okhttp" root artifact's Kotlin-Multiplatform capability POM — it ships
             no class files at all (verified: okhttp-5.1.0.jar is 767 bytes). The real
             JVM implementation is the separately published okhttp-jvm artifact, which
             okhttp's own pom does not declare as a dependency (unlike okio, which does
             declare its -jvm split correctly). Pinned to the exact version minio's pom
             resolves so there is one okhttp version in the tree, just backed by the jar
             that actually has classes in it. -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp-jvm</artifactId>
            <version>5.1.0</version>
        </dependency>

        <!-- AI: LangChain4j — model-agnostic engine. Core carries AiServices +
             declarative guardrails (dev.langchain4j.service.guardrail); the
             open-ai module provides OpenAiChatModel, used against OpenRouter's
             OpenAI-compatible endpoint so one wire format serves every model.
             Models are built dynamically from DB config, so no Spring starter /
             auto-config is needed. Versions managed by langchain4j-bom. -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-open-ai</artifactId>
        </dependency>

        <!-- Resilience4j (used programmatically, not via the Spring Boot starter,
             to stay decoupled from the Boot version): circuit breaker + bulkhead
             around AI provider calls so a sustained outage fast-fails instead of
             every submission exhausting retries against a degraded upstream. -->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-circuitbreaker</artifactId>
            <version>${resilience4j.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-bulkhead</artifactId>
            <version>${resilience4j.version}</version>
        </dependency>

        <!-- RestClient.Builder for OAuth2Controller — not provided by the Anthropic starter (native OkHttp SDK). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-restclient</artifactId>
        </dependency>

        <!-- Observability -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- API Docs. The 3.x line is the one that supports Spring Boot 4 (2.x targets Boot 3). -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>3.0.3</version>
        </dependency>

        <!-- Utility -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Web Push (VAPID) — browser/desktop notifications. jcommander only
             serves the library's CLI and async-http-client only its
             PushAsyncService; we use the synchronous PushService, so both are
             excluded. BouncyCastle (declared optional upstream) supplies the
             EC crypto for VAPID signing + RFC 8291 payload encryption. -->
        <dependency>
            <groupId>nl.martijndwars</groupId>
            <artifactId>web-push</artifactId>
            <version>5.1.2</version>
            <exclusions>
                <exclusion>
                    <groupId>com.beust</groupId>
                    <artifactId>jcommander</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.asynchttpclient</groupId>
                    <artifactId>async-http-client</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
            <version>1.84</version>
        </dependency>
        <!-- Transitive of opensaml-security-api (pinned there at a vulnerable 1.77);
             declared explicitly to bring it in line with bcprov above. -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcpkix-jdk18on</artifactId>
            <version>1.84</version>
        </dependency>
        <!-- web-push declares these runtime-scoped, but PushService's API
             surface leaks them (send returns org.apache.http.HttpResponse and
             throws org.jose4j.lang.JoseException), so the compiler needs both.
             Same versions web-push resolves at runtime. -->
        <dependency>
            <groupId>org.apache.httpcomponents</groupId>
            <artifactId>httpasyncclient</artifactId>
            <version>4.1.5</version>
        </dependency>
        <dependency>
            <groupId>org.bitbucket.b_c</groupId>
            <artifactId>jose4j</artifactId>
            <version>0.9.6</version>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Architecture-freeze tests (ArchUnit). Plain JVM tests, no Spring
             context, so they run in the default `mvn test` loop and stay fast.
             The FreezingArchRule "ratchet" pins today's module-boundary
             violations in a committed violation store so they can only shrink;
             any NEW cross-feature cycle / repository access / controller fan-in
             fails the build. archunit-junit5 pulls in archunit core + the
             JUnit 5 test engine that discovers @ArchTest rules. -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>1.4.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>dev.langchain4j</groupId>
                <artifactId>langchain4j-bom</artifactId>
                <version>${langchain4j.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <!-- 1.20.x's docker-java can't negotiate with Docker Engine 29+ (min API 1.44). -->
                <version>1.21.4</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.13</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check</id>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <!-- Coverage ratchet: raise as coverage grows; never lower. -->
                                            <minimum>0.10</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
